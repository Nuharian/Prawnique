# Prawnique Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# REQUIRED IN PRODUCTION.
# Signs the admin auth cookie. Use a long random string - anyone who knows this
# value can forge an admin session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If this is unset in production the server falls back to a random per-boot
# secret, which signs every admin out on each restart.
SESSION_SECRET=

# Optional. Comma-separated list of extra origins allowed to make credentialed
# requests. Same-origin requests always work, so most deployments leave this blank.
ALLOWED_ORIGINS=

# Optional. Enables POST /api/admin/reset-password as a recovery route.
# Leave blank to keep that endpoint disabled (it returns 404).
# Call it with: {"token": "<this value>", "password": "<new password>"}
ADMIN_RESET_TOKEN=

# Cloudinary (Get these from https://cloudinary.com/console)
# Without these, uploads fall back to local disk, which is NOT persistent on Vercel.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database (Vercel Postgres - Get these from Vercel Dashboard)
# If POSTGRES_URL is unset the app uses a local SQLite file for development.
POSTGRES_URL=your_postgres_connection_string
POSTGRES_PRISMA_URL=your_postgres_prisma_url
POSTGRES_URL_NON_POOLING=your_postgres_non_pooling_url
POSTGRES_USER=your_postgres_user
POSTGRES_HOST=your_postgres_host
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=your_postgres_database

# Password for the seeded 'admin' account, applied when the account is first
# created. Changing it later has no effect - use the reset endpoint above.
ADMIN_PASSWORD=
